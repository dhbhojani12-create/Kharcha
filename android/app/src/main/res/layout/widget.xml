<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_bg" android:padding="12dp">

    <LinearLayout android:id="@+id/w_cards" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Travel cards" android:textColor="@color/w_mut" android:textSize="11sp" android:textStyle="bold"
            android:layout_marginStart="2dp" android:layout_marginBottom="6dp" />
        <LinearLayout android:id="@+id/w_card1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/w_row"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/w_name1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/w_ink" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/w_when1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/w_mut" android:textSize="11sp" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/w_bal1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/w_bal" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_card2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/w_row"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/w_name2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/w_ink" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/w_when2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/w_mut" android:textSize="11sp" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/w_bal2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/w_bal" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tap your card in Kharcha once to see its balance here" android:textColor="@color/w_mut"
            android:textSize="12sp" android:background="@drawable/w_row" android:padding="10dp" android:visibility="gone" />
    </LinearLayout>

    <TextView android:id="@+id/w_cash" android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginTop="8dp" android:background="@drawable/w_btn" android:gravity="center"
        android:text="+  Cash" android:textColor="@color/w_on_btn" android:textSize="15sp" android:textStyle="bold" />
</LinearLayout>
