<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:orientation="vertical" android:background="@drawable/w_bg"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="2dp" android:text="TRAVEL CARDS" android:letterSpacing="0.04"
            android:textColor="@color/w_mut" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_cash" android:layout_width="wrap_content" android:layout_height="36dp"
            android:background="@drawable/w_pill" android:gravity="center"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:text="+  Cash" android:textColor="@color/w_on_btn" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_cards" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <RelativeLayout android:id="@+id/w_card1" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:background="@drawable/w_tile1"
            android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="14dp">
            <ImageView android:id="@+id/w_chipimg1" android:layout_width="26dp" android:layout_height="19dp"
                android:layout_alignParentEnd="true" android:src="@drawable/w_chip" />
            <TextView android:id="@+id/w_name1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_toStartOf="@id/w_chipimg1" android:layout_alignParentStart="true"
                android:textColor="@color/w_tile_mut" android:textSize="12.5sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
            <LinearLayout android:id="@+id/w_balrow1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_below="@id/w_name1" android:layout_marginTop="4dp" android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:id="@+id/w_bal1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/w_tile_ink" android:textSize="28sp" android:textStyle="bold"
                    android:maxLines="1" android:fontFamily="sans-serif-black" />
                <TextView android:id="@+id/w_low1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:background="@drawable/w_low" android:text="Low"
                    android:textColor="@color/w_low" android:textSize="10.5sp" android:textStyle="bold"
                    android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp"
                    android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/w_when1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_below="@id/w_balrow1" android:layout_marginTop="2dp"
                android:textColor="@color/w_tile_mut" android:textSize="11sp" android:maxLines="1" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/w_card2" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:background="@drawable/w_tile2"
            android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:layout_marginStart="10dp">
            <ImageView android:id="@+id/w_chipimg2" android:layout_width="26dp" android:layout_height="19dp"
                android:layout_alignParentEnd="true" android:src="@drawable/w_chip" />
            <TextView android:id="@+id/w_name2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_toStartOf="@id/w_chipimg2" android:layout_alignParentStart="true"
                android:textColor="@color/w_tile_mut" android:textSize="12.5sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
            <LinearLayout android:id="@+id/w_balrow2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_below="@id/w_name2" android:layout_marginTop="4dp" android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:id="@+id/w_bal2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/w_tile_ink" android:textSize="28sp" android:textStyle="bold"
                    android:maxLines="1" android:fontFamily="sans-serif-black" />
                <TextView android:id="@+id/w_low2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:background="@drawable/w_low" android:text="Low"
                    android:textColor="@color/w_low" android:textSize="10.5sp" android:textStyle="bold"
                    android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp"
                    android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/w_when2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_below="@id/w_balrow2" android:layout_marginTop="2dp"
                android:textColor="@color/w_tile_mut" android:textSize="11sp" android:maxLines="1" />
        </RelativeLayout>
        <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tap your card in Kharcha once to see its balance here" android:textColor="@color/w_mut"
            android:textSize="12sp" android:background="@drawable/w_row" android:padding="12dp" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
